QMainWindow, QWidget#centralwidget {
    background-color: #151515;
    color: #eeeeee;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel {
    color: #eeeeee;
    background: transparent;
}

QLabel#logoLabel {
    color: #ffffff;
    font-size: 22pt;
    font-weight: bold;
}

QLabel#pageTitleLabel {
    font-size: 19pt;
    font-weight: bold;
}

QPushButton {
    background-color: #353535;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #484848;
}

QPushButton:pressed {
    background-color: #292929;
}

QLineEdit, QComboBox {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 10px;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #777777;
}

QComboBox QAbstractItemView {
    background-color: #222222;
    color: #eeeeee;
    selection-background-color: #454545;
    selection-color: #ffffff;
    border: 1px solid #3d3d3d;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea QWidget#scrollAreaWidgetContents {
    background-color: transparent;
}
QPushButton:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border-color: #333333;
}

QPushButton:default {
    border: 1px solid #6a6a6a;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    color: #777777;
    background-color: #1b1b1b;
}

QSpinBox,
QDoubleSpinBox,
QDateTimeEdit,
QDateEdit,
QTimeEdit {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 10px;
    min-height: 20px;
    selection-background-color: #454545;
    selection-color: #ffffff;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QDateTimeEdit:focus,
QDateEdit:focus,
QTimeEdit:focus {
    border: 1px solid #777777;
}

QComboBox::drop-down,
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    background: transparent;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #cccccc;
    width: 0;
    height: 0;
    margin-right: 6px;
}

QTextEdit,
QPlainTextEdit {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #454545;
    selection-color: #ffffff;
}

QScrollBar:vertical {
    background: #1b1b1b;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #3d3d3d;
    min-height: 24px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #4d4d4d;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1b1b1b;
    height: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #3d3d3d;
    min-width: 24px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #4d4d4d;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QDialog,
QMessageBox,
QFileDialog,
QInputDialog,
QColorDialog,
QFontDialog,
QProgressDialog,
QErrorMessage,
QWizard,
QWizardPage {
    background-color: #151515;
    color: #eeeeee;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMessageBox QLabel,
QInputDialog QLabel,
QFileDialog QLabel,
QProgressDialog QLabel,
QDialog QLabel {
    color: #eeeeee;
    background: transparent;
}

QDialog QPushButton,
QMessageBox QPushButton,
QInputDialog QPushButton,
QFileDialog QPushButton,
QProgressDialog QPushButton {
    background-color: #353535;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

QDialog QPushButton:hover,
QMessageBox QPushButton:hover,
QInputDialog QPushButton:hover,
QFileDialog QPushButton:hover,
QProgressDialog QPushButton:hover {
    background-color: #484848;
}

QDialog QPushButton:pressed,
QMessageBox QPushButton:pressed,
QInputDialog QPushButton:pressed,
QFileDialog QPushButton:pressed,
QProgressDialog QPushButton:pressed {
    background-color: #292929;
}

QDialogButtonBox QPushButton {
    min-width: 90px;
}

QDialog QAbstractItemView,
QFileDialog QAbstractItemView {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
    selection-background-color: #454545;
    selection-color: #ffffff;
}

QFileDialog QHeaderView::section {
    background-color: #353535;
    color: #eeeeee;
    border: 1px solid #454545;
    padding: 4px;
}

QFileDialog QToolButton {
    background-color: #353535;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 6px;
    padding: 4px;
}

QFileDialog QToolButton:hover {
    background-color: #484848;
}

QFileDialog QToolButton:pressed {
    background-color: #292929;
}

QProgressBar {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #555555;
    border-radius: 5px;
}

QToolTip {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
    padding: 4px;
}

QMenu {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
}

QMenu::item:selected {
    background-color: #454545;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #3d3d3d;
    margin: 4px 8px;
}

QTabWidget::pane {
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    background: #1b1b1b;
    top: -1px;
}

QTabBar::tab {
    background: #222222;
    color: #cccccc;
    border: 1px solid #3d3d3d;
    border-bottom: none;
    padding: 8px 14px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

