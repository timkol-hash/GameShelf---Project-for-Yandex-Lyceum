QMainWindow, QWidget#centralwidget {
    background-color: #151515;
    color: #eeeeee;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

QLabel {
    color: #eeeeee;
    background: transparent;
}

QLabel#logoLabel {
    color: #ffffff;
    font-size: 22pt;
    font-weight: bold;
}

QLabel#pageTitleLabel {
    font-size: 19pt;
    font-weight: bold;
}

QPushButton {
    background-color: #353535;
    color: #ffffff;
    border: 1px solid #454545;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #484848;
}

QPushButton:pressed {
    background-color: #292929;
}

QLineEdit, QComboBox {
    background-color: #222222;
    color: #eeeeee;
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 10px;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #777777;
}

QComboBox QAbstractItemView {
    background-color: #222222;
    color: #eeeeee;
    selection-background-color: #454545;
    selection-color: #ffffff;
    border: 1px solid #3d3d3d;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea QWidget#scrollAreaWidgetContents {
    background-color: transparent;
}

