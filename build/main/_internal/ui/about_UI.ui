        color: #eeeeee;
        font-size: 10pt;
    }

    QScrollArea {
        background-color: transparent;
        border: none;
    }

    QScrollArea QWidget#scrollContents {
        background-color: transparent;
    }

    QScrollBar:vertical {
        background: transparent;
        width: 10px;
        margin: 0;
    }

    QScrollBar::handle:vertical {
        background: #3d3d3d;
        border-radius: 5px;
        min-height: 24px;
    }

    QScrollBar::handle:vertical:hover {
        background: #555555;
    }

    QScrollBar::add-line:vertical,
    QScrollBar::sub-line:vertical,
    QScrollBar::add-page:vertical,
    QScrollBar::sub-page:vertical {
        background: none;
        height: 0;
    }

    QPushButton {
        background-color: #353535;
        color: #ffffff;
        border: 1px solid #454545;
        border-radius: 8px;
        padding: 10px 16px;
        font-weight: bold;
    }

    QPushButton:hover {
        background-color: #484848;
    }

    QPushButton:pressed {
        background-color: #292929;
    }</string>
